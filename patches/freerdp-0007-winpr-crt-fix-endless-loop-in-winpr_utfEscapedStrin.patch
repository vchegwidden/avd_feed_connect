From c9777eb5631d2f3f9ab4604aed771e7a0493c75e Mon Sep 17 00:00:00 2001
From: Ewerton Mattos <ewer@outlook.com>
Date: Tue, 6 Oct 2026 08:58:55 -0300
Subject: [PATCH] [winpr,crt] fix endless loop in winpr_utfEscapedStringToUtf8

When the input contained "\u" not followed by four hex digits (for
example a Windows path like "C:\users\..."), the loop continued without
advancing, so winpr_strnstr found the same position again and the
function never returned. Clipboard text conversion from CF_TEXT or
text/plain goes through this function, so such text hung the caller.

Skip past an invalid escape and keep it as literal text. After a
successful conversion, continue after the decoded bytes so an escape
that decodes to a backslash (\u005c) is not decoded a second time.
Keep the search length in step with the current position.

Add test cases for literal and malformed escapes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../libwinpr/crt/test/TestUnicodeConversion.c | 35 +++++++++++++++++++
 winpr/libwinpr/crt/unicode.c                  |  9 +++++
 2 files changed, 44 insertions(+)

diff --git a/winpr/libwinpr/crt/test/TestUnicodeConversion.c b/winpr/libwinpr/crt/test/TestUnicodeConversion.c
index c62ac65..b4d89f1 100644
--- a/winpr/libwinpr/crt/test/TestUnicodeConversion.c
+++ b/winpr/libwinpr/crt/test/TestUnicodeConversion.c
@@ -1226,6 +1226,39 @@ static BOOL testEscape(void)
 	}
 	return TRUE;
 }
+
+WINPR_ATTR_NODISCARD
+static BOOL testUnescapeLiteral(void)
+{
+	/* Text that is not a valid \uXXXX escape must pass through unchanged */
+	const struct
+	{
+		const char* in;
+		const char* out;
+	} tests[] = { { "C:\\users\\test", "C:\\users\\test" },
+		          { "see \\utils here", "see \\utils here" },
+		          { "end \\u12", "end \\u12" },
+		          { "\\uzzzz\\u0041", "\\uzzzzA" },
+		          { "\\u005cu0041", "\\u0041" } };
+
+	for (size_t x = 0; x < ARRAYSIZE(tests); x++)
+	{
+		char* str = _strdup(tests[x].in);
+		if (!str)
+			return FALSE;
+
+		const SSIZE_T res = winpr_utfEscapedStringToUtf8(str, strlen(str));
+		const BOOL ok =
+		    (res >= 0) && ((size_t)res == strlen(tests[x].out)) && (strcmp(str, tests[x].out) == 0);
+		if (!ok)
+			(void)fprintf(stderr, "unescape '%s': got '%s', expected '%s'\n", tests[x].in, str,
+			              tests[x].out);
+		free(str);
+		if (!ok)
+			return FALSE;
+	}
+	return TRUE;
+}
 #endif
 
 int TestUnicodeConversion(int argc, char* argv[])
@@ -1375,6 +1408,8 @@ int TestUnicodeConversion(int argc, char* argv[])
 #if defined(BUILD_TESTING_INTERNAL)
 	if (!testEscape())
 		return -1;
+	if (!testUnescapeLiteral())
+		return -1;
 #endif
 
 	return 0;
diff --git a/winpr/libwinpr/crt/unicode.c b/winpr/libwinpr/crt/unicode.c
index 844f54b..19a539a 100644
--- a/winpr/libwinpr/crt/unicode.c
+++ b/winpr/libwinpr/crt/unicode.c
@@ -706,7 +706,12 @@ SSIZE_T winpr_utfEscapedStringToUtf8(char* str, size_t len)
 		char* next = nullptr;
 		const INT32 code = escapeToNumber(cur, &next);
 		if (code < 0)
+		{
+			/* Not a \uXXXX escape (e.g. "C:\users"): keep it as literal text */
+			cur += 2;
+			clen = len - (size_t)(cur - str);
 			continue;
+		}
 
 		WCHAR wc[2] = WINPR_C_ARRAY_INIT;
 		wc[0] = ((WCHAR)code);
@@ -738,6 +743,10 @@ SSIZE_T winpr_utfEscapedStringToUtf8(char* str, size_t len)
 			const size_t rlen = strnlen(next, len);
 			memmove(&cur[(size_t)rc], next, rlen + 1);
 		}
+
+		/* Continue after the decoded bytes, so they are never decoded again */
+		cur += rc;
+		clen = len - (size_t)(cur - str);
 	}
 	return (SSIZE_T)strnlen(str, len);
 }
-- 
2.55.0

