 winpr/libwinpr/clipboard/clipboard.h          |   20 +
 winpr/libwinpr/clipboard/synthetic.c          | 1010 ++++++-----------
 winpr/libwinpr/clipboard/synthetic_file.c     |  140 ++-
 .../clipboard/test/TestClipboardFormats.c     |  245 +++-
 winpr/libwinpr/utils/image.c                  |   53 +-
 6 files changed, 792 insertions(+), 781 deletions(-)

